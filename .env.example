# BookNook / Minha Estante - Environment Template
# Copie para .env e preencha as variáveis correspondentes caso necessário.

# Google Gemini API Key (para resumos no backend Express)
GEMINI_API_KEY=

# Android Keystore Configuration (Segredos de Assinatura para Google Play)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=booknook

# Porta do servidor (padrão: 3000)
PORT=3000
